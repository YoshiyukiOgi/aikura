APP_NAME="AI蔵"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_JP

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=aikura
DB_USERNAME=aikura
DB_PASSWORD=aikura
DB_TIMEZONE=Asia/Tokyo

# 小売販売システムは初期状態では同じDBを使います。
# 将来DB分離する場合は RETAIL_DB_* だけを別DBへ向けます。
RETAIL_DOMAIN=
RETAIL_ROUTE_PREFIX=retail
RETAIL_DB_CONNECTION=retail
RETAIL_DB_HOST=${DB_HOST}
RETAIL_DB_PORT=${DB_PORT}
RETAIL_DB_DATABASE=${DB_DATABASE}
RETAIL_DB_USERNAME=${DB_USERNAME}
RETAIL_DB_PASSWORD=${DB_PASSWORD}
RETAIL_DB_TIMEZONE=${DB_TIMEZONE}
RETAIL_DB_SCHEMA=public

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
